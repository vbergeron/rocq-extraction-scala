# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Scala 3 extraction backend for the Rocq Prover"
description:
  "A Rocq plugin adding Scala as a target language of extraction: once loaded, `Extraction Language Scala` makes the extraction commands produce Scala 3 source."
maintainer: ["Valentin Bergeron <bergeron.valentin@gmail.com>"]
authors: ["Valentin Bergeron"]
license: "LGPL-2.1-only"
homepage: "https://github.com/vbergeron/rocq-extraction-scala"
bug-reports: "https://github.com/vbergeron/rocq-extraction-scala/issues"
depends: [
  "dune" {>= "3.21"}
  "rocq-runtime" {>= "9.4~"}
  "rocq-core" {>= "9.4~"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/vbergeron/rocq-extraction-scala.git"
x-maintenance-intent: ["(latest)"]
